rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------ HELPERS ------------------ */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    /* ------------------ PRODUCTS ------------------ */
    match /products/{productId} {
      // Anyone logged in can view products
      allow read: if isSignedIn();

      // Admins can create or delete products
      allow create, delete: if isAdmin();
      
      // Any logged in user (staff/admin) needs to update products 
      // to record sales or damages (which reduces stock)
      allow update: if isSignedIn(); 
    }

    /* ------------------ HISTORY ------------------ */
    match /history/{historyId} {
      // Anyone logged in can view sales/damage history
      allow read: if isSignedIn();

      // Any logged-in user can record a sale or damage
      allow create: if isSignedIn();

      // Only admins can edit or delete history records
      allow update, delete: if isAdmin();
    }

    /* ------------------ USERS ------------------ */
    match /users/{userId} {
      // User can read their own profile
      allow read: if isSignedIn() && request.auth.uid == userId;

      // User can update only their own basic profile
      allow update: if isSignedIn() && request.auth.uid == userId;

      // Admin can read, update or delete ANY user
      allow read, write, delete: if isAdmin();
    }

    /* ------------------ FALLBACK ------------------ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
